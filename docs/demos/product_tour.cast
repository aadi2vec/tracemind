[194.726255, "o", "\r\n\u001b[1m\u001b[36m▸ 26. Weekly digest\u001b[0m\r\n\u001b[2mEvery week the daemon summarizes captures by modality + unresolved contradictions + open commitments to ~/.tracemind/notifications/ so a menu-bar app can badge it.\u001b[0m\r\n"]
