[165.441063, "o", "  confidence   0.078\r\n  lexical      0.311\r\n  recency      0.078\r\n  text         0.533\r\n  min_score      0.150\r\n  cand_mult      4\r\n  coverage_wt    0.080\r\n  fit_wt         1.000\r\n  generic_boost  15.400\r\n"]
[168.461354, "o", "\r\n\u001b[1m\u001b[36m▸ 23. Nightly on-device self-improvement (Q4.4)\u001b[0m\r\n\u001b[2mRuns on the laptop: GEPA spike, verb affinity update, tier cycle, contradiction-rate. Results persisted to ~/.tracemind/nightly_runs.jsonl. Nothing leaves the device.\u001b[0m\r\n"]
[170.473839, "o", "\r\n\u001b[33m$ ./target/release/tracemind nightly --help 2>&1 | head -12\u001b[0m\r\n"]
[171.495142, "o", "[tracemind] using bundled models from /Users/aadityasrivathsan/Desktop/agent_memory_system/target/release/models (bundle)\r\n"]
[171.496329, "o", "Q4.4 — Run nightly self-improvement tasks on-device. Triggers GEPA spike, verb affinity update, tier cycle, and contradiction rate computation. Results are persisted to `~/.tracemind/nightly_runs.jsonl`\r\n\r\nUsage: tracemind nightly [OPTIONS]\r\n\r\nOptions:\r\n      --hash-embed  Use deterministic hash embedder instead of ONNX model (offline/test mode)\r\n  -h, --help        Print help\r\n"]
[174.516741, "o", "\r\n\u001b[1m\u001b[35m════════════════════════════════════════════════════════\u001b[0m\r\n\u001b[1m\u001b[35m ACT IX — Privacy story (LM-16)\u001b[0m\r\n"]
