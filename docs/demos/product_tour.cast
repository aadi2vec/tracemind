[127.800935, "o", "\r\n\u001b[1m\u001b[36m▸ 17. Daily brief\u001b[0m\r\n\u001b[2mOverdue + open + recently resolved + pending candidates. This is what a menu-bar surface would badge in the morning.\u001b[0m\r\n"]
