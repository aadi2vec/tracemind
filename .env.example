# Copy this to .env and fill in your values.
# The docker-compose stack will pick these up automatically.

# ── LLM ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o                        # options: gpt-4o, ollama/llama3.2, ollama/mistral
EMBEDDING_MODEL=text-embedding-3-small  # options: text-embedding-3-small, ollama/nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434  # default for local Ollama

# ── Neo4j ───────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── ChromaDB ────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
